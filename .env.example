# Copy to .env. The model id prefix picks the provider for each role:
#   gemini/<model>     Google AI Studio free tier, needs GEMINI_API_KEY ($0)
#   vertex_ai/<model>  Vertex AI on a GCP project, needs VERTEXAI_PROJECT and
#                      gcloud application-default credentials (billed per call)
# Roles may mix providers. Every model id must have an entry in configs/limits.yaml.

# --- Option A (default): AI Studio free tier --------------------------------
GEMINI_API_KEY=
TARGET_MODEL=gemini/gemma-4-31b-it
ATTACKER_MODEL=gemini/gemma-4-26b-a4b-it
MONITOR_MODEL=gemini/gemini-3.1-flash-lite

# --- Option B: Vertex AI (uncomment, and comment out the Option A model ids) --
# Run `gcloud auth application-default login` first. Current models answer only
# on the global location. Gemma 4 31B is not offered as a managed model on
# Vertex; Gemma 4 26B is, and its id needs the "gemini/" segment so LiteLLM
# uses the generateContent route.
# VERTEXAI_PROJECT=your-gcp-project-id
# VERTEXAI_LOCATION=global
# TARGET_MODEL=vertex_ai/gemini/gemma-4-26b-a4b-it-maas
# ATTACKER_MODEL=vertex_ai/gemini-3.1-flash-lite
# MONITOR_MODEL=vertex_ai/gemini-3.1-flash-lite

# auto (default) folds a rejected system prompt into the first user message.
# Set true or false to force the choice.
SYSTEM_AS_USER=false
RUNS_DIR=runs
