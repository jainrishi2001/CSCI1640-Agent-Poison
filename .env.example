VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=us-central1
TARGET_MODEL=gemini/gemma-4-31b-it
ATTACKER_MODEL=gemini/gemma-4-26b-a4b-it
MONITOR_MODEL=gemini/gemini-3.1-flash-lite
# Required for gemini/ model ids. Leave empty when calling Vertex instead.
GEMINI_API_KEY=
# auto (default) folds a rejected system prompt into the first user message.
# Set true or false to force the choice.
# SYSTEM_AS_USER=auto
RUNS_DIR=runs
